# MCHS Live configuration.
#
# Production: systemd loads /etc/mchs-live/mchs-live.env (EnvironmentFile=).
# Development: copy this file to web-portal/.env, or export the variables.
# Variables already set in the process environment win over the .env file.
# Relative paths (DATA_DIR, APNS_KEY_PATH) are resolved against the
# web-portal directory, so the server and the CLI agree whatever the cwd.

# Listen address and port. Keep HOST on loopback: Caddy is the public listener.
HOST=127.0.0.1
PORT=8080

# External base URL (logs / links only).
PUBLIC_URL=http://localhost:8080

# Directory holding live.db (must be writable: SQLite WAL needs -wal/-shm files).
DATA_DIR=./data

# 1 = trust X-Forwarded-For / X-Forwarded-Proto when the peer is loopback (Caddy).
TRUST_PROXY=1

# Portal branding and defaults for new games. Keep the color in double
# quotes: in a .env file an unquoted '#' starts a comment.
SCHOOL_NAME=Marquette Catholic
HOME_TEAM_NAME=Marquette
HOME_TEAM_CODE=MAR
HOME_TEAM_COLOR="#12214D"

# Scorekeepers may start a game this many minutes before its scheduled time
# (admins may start any time).
START_WINDOW_MINUTES=120

# Live games nobody has changed (scored, edited) for this many hours are
# ended automatically.
AUTO_FINAL_HOURS=4

# The school's time zone (IANA name). The web portal and the iOS app show game
# times in it (and admins enter them in it), whatever zone a device is set to.
SCHOOL_TIMEZONE="America/Chicago"

# Per-client limits. Fans at a game usually reach the server from one school
# Wi-Fi or carrier NAT address, so these are generous. A client is one IPv4
# address or one IPv6 /64. Signed-in admins and scorekeepers are never
# limited by RATE_LIMIT_PER_MINUTE; sign-in has its own failure throttling.
# Concurrent live-score streams (SSE) per client, and in total:
SSE_MAX_PER_IP="2000"
SSE_MAX_CONNECTIONS="20000"
# Anonymous /api requests per client per minute:
RATE_LIMIT_PER_MINUTE="3000"
# Device (push-to-start token) registrations per client per minute:
DEVICE_RATE_LIMIT_PER_MINUTE="600"

# APNs token authentication. Leave any of the three blank to run without
# pushes (/api/health then reports apns.configured=false).
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=org.marquettecatholic.app

# Environments to serve (comma separated): production, sandbox.
APNS_ENVIRONMENTS=production,sandbox

# Broadcast channel message storage policy: 0 = No Message Stored (recommended
# for sports scores, higher budget), 1 = Most Recent Message Stored.
APNS_CHANNEL_STORAGE_POLICY=0

# Base minimum interval between broadcast updates per game (adaptive on 429).
APNS_MIN_UPDATE_INTERVAL_MS=5000

# debug | info | warn | error
LOG_LEVEL=info
